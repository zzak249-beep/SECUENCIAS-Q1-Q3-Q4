# ---- Telegram (obligatorio para recibir señales) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Universo ----
TIMEFRAME=1h
HTF_TIMEFRAME=4h
# 0 = analizar TODAS las monedas de BingX
TOP_N=0
# 0 = sin filtro de liquidez (no recomendado); 300000 descarta monedas casi sin volumen
MIN_VOLUME_USD=300000

# ---- Límites de la API ----
RATE_LIMIT_MS=350
MAX_RETRIES=4

# ---- Frecuencia ----
SCAN_INTERVAL_MIN=15
COOLDOWN_HOURS=12
DIGEST_HOURS=6

# ---- Calidad de señal ----
MIN_SCORE=60
REQUIRE_HTF=false
MAX_EXTENSION_ATR=2.0
ALLOW_LONG=true
ALLOW_SHORT=true

# ---- Riesgo (solo informativo) ----
ACCOUNT_USD=1000
RISK_PCT=1.0
MAX_LEVERAGE=3
ATR_STOP=1.5
TP1_R=1.5
TP2_R=3.0
MAX_HOLD_HOURS=48

# ---- Wavelet (WAVELET_WINDOW: 16, 32, 64, 128 o 256) ----
WAVELET_WINDOW=64
WAVELET_MULT=1.0
SLOPE_LEN=8
MIN_SLOPE_Z=1.0
