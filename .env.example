# Copia este fichero a .env SOLO para pruebas locales (no lo subas a GitHub).
# En Railway estas variables se ponen en la pestana "Variables".
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionales (valores por defecto entre parentesis)
